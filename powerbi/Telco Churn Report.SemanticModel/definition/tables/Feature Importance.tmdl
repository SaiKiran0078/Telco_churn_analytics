table 'Feature Importance'
	lineageTag: 261a290d-9275-54d9-b8cb-add1a1d88c77

	column Feature
		dataType: string
		lineageTag: 015bfdbf-d750-5fd7-b8e0-c5103b0ea063
		summarizeBy: none
		sourceColumn: Feature

		annotation SummarizationSetBy = Automatic

	column 'AUC Drop'
		dataType: double
		formatString: 0.000
		lineageTag: 731d01b4-b4be-59cf-8e5c-941f1668352a
		summarizeBy: none
		sourceColumn: AUC Drop

		annotation SummarizationSetBy = Automatic

	column 'AUC Drop SD'
		dataType: double
		formatString: 0.000
