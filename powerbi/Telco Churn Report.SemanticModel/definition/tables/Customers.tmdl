				    #"No Phone To No" = Table.ReplaceValue(#"No Internet To No", "No phone service", "No", Replacer.ReplaceText, {"MultipleLines"}),
				    #"Clean Payment Method" = Table.TransformColumns(#"No Phone To No", {{"PaymentMethod", each Text.Replace(_, " (automatic)", ""), type text}}),
