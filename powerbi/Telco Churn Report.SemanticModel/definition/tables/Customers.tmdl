				    #"Expanded Risk" = Table.ExpandTableColumn(#"Merged Risk Scores", "Risk", {"segment", "churn_probability", "risk_tier", "recommended_action"}, {"Segment", "Churn Probability", "Risk Tier", "Recommended Action"}),
