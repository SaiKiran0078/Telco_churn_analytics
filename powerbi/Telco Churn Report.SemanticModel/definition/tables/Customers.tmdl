				    #"Churn Flag" = Table.AddColumn(#"Renamed Columns", "Churn Flag", each if [Churn] = "Yes" then 1 else 0, Int64.Type),
				    #"Customer Status" = Table.AddColumn(#"Churn Flag", "Customer Status", each if [Churn] = "Yes" then "Churned" else "Retained", type text),
				    #"Num Services" = Table.AddColumn(#"Customer Status", "Num Services", each (if [Phone Service] = "Yes" then 1 else 0) + (if [Internet Service] <> "No" then 1 else 0) + List.Count(List.Select({[Online Security], [Online Backup], [Device Protection], [Tech Support], [Streaming TV], [Streaming Movies]}, each _ = "Yes")), Int64.Type),
				    #"Protection Sort" = Table.AddColumn(#"Num Services", "Protection Sort", each if [Internet Service] = "No" then -1 else List.Count(List.Select({[Online Security], [Online Backup], [Device Protection], [Tech Support]}, each _ = "Yes")), Int64.Type),
				    #"Protection Services Held" = Table.AddColumn(#"Protection Sort", "Protection Services Held", each if [Protection Sort] = -1 then "No internet" else Text.From([Protection Sort]), type text),
				    #"Tenure Band Sort" = Table.AddColumn(#"Protection Services Held", "Tenure Band Sort", each if [Tenure Months] <= 6 then 1 else if [Tenure Months] <= 12 then 2 else if [Tenure Months] <= 24 then 3 else if [Tenure Months] <= 48 then 4 else 5, Int64.Type),
				    #"Tenure Band" = Table.AddColumn(#"Tenure Band Sort", "Tenure Band", each if [Tenure Months] <= 6 then "0-6 months" else if [Tenure Months] <= 12 then "7-12 months" else if [Tenure Months] <= 24 then "13-24 months" else if [Tenure Months] <= 48 then "25-48 months" else "49-72 months", type text),
				    #"Charge Band Sort" = Table.AddColumn(#"Tenure Band", "Charge Band Sort", each if [Monthly Charges] < 35 then 1 else if [Monthly Charges] < 70 then 2 else if [Monthly Charges] < 90 then 3 else 4, Int64.Type),
				    #"Charge Band" = Table.AddColumn(#"Charge Band Sort", "Charge Band", each if [Monthly Charges] < 35 then "Under $35" else if [Monthly Charges] < 70 then "$35-69" else if [Monthly Charges] < 90 then "$70-89" else "$90 and over", type text),
				    #"Risk Scores" = Csv.Document(File.Contents(RepoRoot & "\reports\tables\customer_risk_scores.csv"), [Delimiter = ",", Columns = 9, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
